{
  "name": "monkey",
  "description": "Donkey Kong with PNG sprites, AABB physics, 3 levels, demo/joystick.",
  "commands": {
    "build": "make",
    "run": "sudo make run",
    "clean": "make clean"
  },
  "hardware": {
    "display": "ST7789 240x240 via SPI ioctl (/dev/spidev0.0)",
    "gpio": "ioctl /dev/gpiochip0 (sin librerias externas)",
    "dependencies": "ninguna (same pattern as pacman/cars)",
    "joystick": "Optional: UP/DOWN/LEFT/RIGHT + BTN_A/B"
  }
}
